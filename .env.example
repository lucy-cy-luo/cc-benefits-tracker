# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Phase 1 needs NONE of these — the manual tracker runs with no secrets at all.
# They exist so Phase 2 (Plaid) has a home. Leave them blank until then.

# --- App -------------------------------------------------------------------
# Leave DATABASE_PATH unset to use the default:
#   ~/Library/Application Support/cc-benefits-tracker/benefits.db
# DO NOT point this inside Google Drive / Dropbox / iCloud. This project folder
# IS in Google Drive — putting the DB here would sync your financial data (and,
# from Phase 2, your Plaid tokens) to Google, and risks SQLite corruption from
# mid-write syncing. The app refuses to start if it detects a cloud path.
# DATABASE_PATH=

HOST=127.0.0.1          # loopback only. Do not bind 0.0.0.0 — this is local-first.
PORT=8420

# --- Plaid (Phase 2) -------------------------------------------------------
# Start in sandbox. Switch to production only when you're ready to link real cards.
PLAID_ENV=sandbox              # sandbox | production
PLAID_CLIENT_ID=
PLAID_SECRET=

# --- Encryption (Phase 2) --------------------------------------------------
# Plaid access tokens are encrypted at rest before ever touching SQLite.
# Key source: macos_keychain (recommended) | passphrase
# With macos_keychain the key is generated on first run and stored in the
# system Keychain — it never lands on disk in plaintext and never enters git.
ENCRYPTION_KEY_SOURCE=macos_keychain
KEYCHAIN_SERVICE_NAME=cc-benefits-tracker
# Only used if ENCRYPTION_KEY_SOURCE=passphrase:
# ENCRYPTION_PASSPHRASE=
